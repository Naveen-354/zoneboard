# Copy this file to `.env` (same folder) and fill in your own values. `.env` is git-ignored.
# NEVER paste these values into chat, issues, commit messages or logs.
#
# Fyers API v3 "individual app": create it at https://myapi.fyers.in/dashboard
#   - App permissions: tick Market Data only. Do NOT enable order/trading permissions.
#   - Redirect URL: must be EXACTLY the FYERS_REDIRECT_URI below.

FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://127.0.0.1:5000/api/nse/callback
